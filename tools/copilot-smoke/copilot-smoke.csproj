<Project Sdk="Microsoft.NET.Sdk">

  <!-- Per-developer environment check, not app code. Run through tools/setup.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- PermissionDecision is marked experimental in GitHub.Copilot.SDK 1.0.15 -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.15" />
  </ItemGroup>

</Project>
