<Project Sdk="Microsoft.NET.Sdk">

  <!-- H1 compatibility probe (plan section 4.5): executable discovery, not app code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- PermissionDecision is marked experimental in GitHub.Copilot.SDK 1.0.15 -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="$(CopilotSdkVersion)" />
  </ItemGroup>

</Project>
