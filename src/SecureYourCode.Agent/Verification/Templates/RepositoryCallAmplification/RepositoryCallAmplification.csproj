<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-owned benchmark template (plan §4.6). The host copies this folder for each run and replaces __DEMO_PROJECT__
       with the demo project's absolute path. Never built in place. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="__DEMO_PROJECT__" />
  </ItemGroup>

</Project>
