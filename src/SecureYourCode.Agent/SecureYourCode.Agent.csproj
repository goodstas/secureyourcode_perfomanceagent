<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- PermissionDecision (the strict handler) is marked experimental in GitHub.Copilot.SDK 1.0.15 (H1). -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Prompts\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Benchmark templates reference the demo project and are built per run under StateRoot, never as part of the host. -->
  <ItemGroup>
    <Compile Remove="Verification\Templates\**" />
    <None Remove="Verification\Templates\**" />
    <Content Remove="Verification\Templates\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.15" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

</Project>
