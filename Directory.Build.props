<Project>
  <!--
    GitHub.Copilot.SDK version used by every project that references it (H8). Default: the version verified in H1.
    Override without editing project files, for example on an air-gapped machine whose feed carries another version:
      dotnet build -p:CopilotSdkVersion=1.0.13      or the environment variable CopilotSdkVersion=1.0.13
    Each SDK version pins its own Copilot CLI runtime version (1.0.15 -> 1.0.89, 1.0.13 -> 1.0.83); see docs/architecture.md.
  -->
  <PropertyGroup>
    <CopilotSdkVersion Condition="'$(CopilotSdkVersion)' == ''">1.0.15</CopilotSdkVersion>
  </PropertyGroup>

  <!--
    How the analyzer tests run (plan §4.3, restored after the H8 audit):
      Testing     (default) Microsoft.CodeAnalysis.CSharp.Analyzer.Testing, as the plan requires. Needs its packages
                  (DiffPlex, NuGet.*, Microsoft.VisualStudio.Composition, ...) on the NuGet source, and it resolves
                  Microsoft.NETCore.App.Ref 8.0.0 from NuGet when the tests run.
      Standalone  a self-contained harness on Roslyn alone, for an air-gapped feed without those packages. Same markup,
                  same tests. Select it with -p:AnalyzerTestHarness=Standalone or the environment variable
                  AnalyzerTestHarness=Standalone (tools/setup.py does this in air-gapped mode).
  -->
  <PropertyGroup>
    <AnalyzerTestHarness Condition="'$(AnalyzerTestHarness)' == ''">Testing</AnalyzerTestHarness>
  </PropertyGroup>
</Project>
